{
  "name": "focusdrive-desktop-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "FocusDrive Workstation Telemetry Desktop Agent Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=apps/desktop",
    "build:extension": "npm run build --workspace=apps/browser-extension --if-present",
    "build": "npm run build:packages && npm run build:frontend",
    "test:frontend": "npm run test --workspace=apps/desktop --if-present",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test": "npm run test:rust",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.3"
  }
}
