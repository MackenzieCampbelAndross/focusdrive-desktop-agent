# FocusDrive Desktop Agent Environment Configuration
# Copy this file to .env for local development

# Environment Mode (development | staging | production)
NODE_ENV=development

# Supabase Configuration (Placeholder values for early phase dev / mock mode)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Desktop Agent Runtime Configuration
FOCUSDRIVE_AGENT_ENV=development
FOCUSDRIVE_IDLE_THRESHOLD_SECONDS=60
FOCUSDRIVE_SYNC_INTERVAL_SECONDS=30
FOCUSDRIVE_MOCK_MODE=true

# Native Messaging Host Config
NATIVE_MESSAGING_HOST_NAME=com.focusdrive.desktopagent.native
